---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import TrainingRequestForm from "../components/TrainingRequestForm.astro";
import { registration } from "../data/registration";
import "../styles/registration.css";
import { getTraining } from "../lib/training-source";
import { requestableSessionOptions } from "../lib/registration/sessions";
const training = await getTraining();
const sessions = requestableSessionOptions(training.sessions, training.venues);
---
<Base title="Trainingsanfrage – Anmeldung & PDF" description="Einzeltermin oder 5er-Paket bei der PK Hockey Academy anfragen. Die Onlineanmeldung wird vorbereitet; die Papiervorlage steht als PDF bereit." noindex clientRouting={false}>
  <section class="page-hero">
    <div class="wrap">
      <a href="/" class="breadcrumb">STARTSEITE <span aria-hidden="true">/</span> ANMELDUNG</a>
      <p class="eyebrow">DEIN WEG ZUM TRAINING</p>
      <h1>DER ERSTE SCHRITT.<br /><span>DEIN FORMULAR.</span></h1>
      <p class="page-intro">Dein Weg zum Einzeltraining oder 5er-Paket. Die Academy prüft jede Anfrage und bestätigt deine Buchung persönlich. Der Onlineversand wird noch vorbereitet.</p>
      <div class="registration-hero-actions">
        <a href="#formular" class="button button--primary"><span>Formularvorschau ansehen</span><Arrow /></a>
        <a href={registration.downloadUrl} download={registration.downloadName} class="button button--outline"><span>PDF-Vorlage herunterladen</span><Arrow diagonal /></a>
      </div>
    </div>
    <div class="page-hero-lines" aria-hidden="true"></div>
  </section>

  <section class="section registration-section" aria-labelledby="registration-heading">
    <div class="wrap registration-layout">
      <div class="registration-main" id="formular">
        <p class="eyebrow">DEINE TRAININGSANFRAGE</p>
        <h2 id="registration-heading">ALLE ANGABEN.<br /><span>IM ÜBERBLICK.</span></h2>
        <p class="registration-training-format">{registration.tagline}<br /><strong>{registration.trainingFormat}</strong></p>
        <TrainingRequestForm sessions={sessions} />
        <p class="registration-end-note">Über diese Seite werden keine Anmeldungen angenommen oder Trainingsplätze gebucht.</p>
      </div>

      <aside class="registration-sidebar" aria-labelledby="registration-download-heading">
        <div class="registration-download">
          <span class="registration-pdf-icon" aria-hidden="true">PDF</span>
          <p class="eyebrow">ZUM HERUNTERLADEN</p>
          <h2 id="registration-download-heading">DEINE<br /><span>PAPIERVORLAGE.</span></h2>
          <p>Die unveränderte, bereitgestellte Vorlage mit allen acht Abschnitten und Unterschriftsfeldern.</p>
          <dl>
            <div><dt>Format</dt><dd>A4 · {registration.pages} Seiten</dd></div>
            <div><dt>Dateigröße</dt><dd>{Math.round(registration.sizeBytes / 1000)} kB</dd></div>
          </dl>
          <a href={registration.downloadUrl} download={registration.downloadName} class="button button--primary"><span>PDF herunterladen</span><Arrow /></a>
          <p class="registration-small">Die Papiervorlage enthält zusätzliche Erklärungen und einen Hinweis auf die erforderliche rechtliche Prüfung. Die Onlineanfrage beschränkt sich auf die für die erste Anfrage nötigen Angaben und getrennte freiwillige Einwilligungen. Beide Fassungen sind noch nicht zur Annahme echter Daten freigegeben.</p>
        </div>
        <div class="registration-process">
          <h3>Wie geht es weiter?</h3>
          <p>Die Abgabe ausgefüllter Papierformulare und der sichere Versand der Onlineanmeldung werden noch abgestimmt. Bitte sende vorerst keine ausgefüllten Formulare über unbestätigte Kontaktwege.</p>
          <h3>Formular &amp; Trainingstermin</h3>
          <p>Die Vorlage umfasst Einzel- und Mehrfachbuchungen. Eine Trainingsanfrage wird erst nach Bestätigung durch die Academy verbindlich.</p>
          <a href="/trainingstermine" class="registration-inline-link">Trainingstermine ansehen <Arrow /></a>
        </div>
      </aside>
    </div>
  </section>
</Base>
