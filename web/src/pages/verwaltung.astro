---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import { getStudioUrl } from "../lib/admin";
const studioUrl = getStudioUrl(import.meta.env);
---

<Base
  noindex
  title="Redaktion – Trainerprofile und Camp-Galerie verwalten"
  description="Geschützter Redaktionszugang für Pierre Klein und freigeschaltete Administratoren der PK Hockey Academy."
>
  <section class="page-hero">
    <div class="wrap">
      <a href="/" class="breadcrumb">
        STARTSEITE <span aria-hidden="true">/</span> REDAKTION
      </a>
      <p class="eyebrow">PK HOCKEY ACADEMY · REDAKTION</p>
      <h1>
        UNSERE ACADEMY.
        <br />
        <span>GEMEINSAM GESTALTEN.</span>
      </h1>
      <p class="page-intro">
        Der Redaktionsbereich für Pierre und freigeschaltete Administratoren.
        Trainerprofile bearbeiten, Camp-Alben anlegen, Fotos und Videos hochladen
        und bestätigte Inhalte freigeben.
      </p>
    </div>
  </section>
  <section class="section light-section">
    <div class="wrap editorial-intro">
      <p class="eyebrow">PERSÖNLICHER ZUGANG</p>
      <h2>{studioUrl ? "ZUR REDAKTION." : "ZUGANG FOLGT."}</h2>
      {studioUrl ? (
        <>
          <p class="lead">
            Melde dich mit deinem freigeschalteten Sanity-Konto an.
          </p>
          <p>
            Verwende dieselbe Anmeldemethode wie bei deiner Einladung. Nur
            freigeschaltete Projektmitglieder mit passenden Rechten können
            Profile und Alben bearbeiten. Die Anmeldung erfolgt direkt bei Sanity.
          </p>
          <Button href={studioUrl}>Redaktion öffnen</Button>
          <p class="small">
            Hilfe zu Vorschau, Veröffentlichung und Abmeldung findest du im
            Studio unter „Redaktionshilfe“. Änderungen erscheinen nach einem
            erfolgreichen Website-Build.
          </p>
        </>
      ) : (
        <>
          <p class="lead">Der Redaktionszugang wird noch eingerichtet.</p>
          <p>
            Sobald der geschützte Bereich verbunden ist, können eingeladene
            Administratoren hier zur Anmeldung gelangen. Aktuell ist über diese
            Seite keine Bearbeitung und kein Upload möglich.
          </p>
          <Button href="/galerie" variant="outline">
            Zur Camp-Galerie
          </Button>
        </>
      )}
    </div>
  </section>
</Base>
