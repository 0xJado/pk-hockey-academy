---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import TrainingStory from "../components/TrainingStory.astro";
import TrainerCard from "../components/TrainerCard.astro";
import Schedule from "../components/Schedule.astro";
import Pricing from "../components/Pricing.astro";
import FinalCTA from "../components/FinalCTA.astro";
import PrivacyPolicy from "../components/PrivacyPolicy.astro";
import { pages, principles, organisationSteps } from "../data/pages";
import type { ContentPage } from "../data/pages";
import { legalProvider } from "../data/legal";
import { getTraining } from "../lib/training-source";
import { getTrainers } from "../lib/trainer-source";

export function getStaticPaths() {
  return Object.keys(pages).map((page) => ({ params: { page } }));
}
const slug = Astro.params.page as ContentPage;
const page = pages[slug];
const { venues } = await getTraining();
const trainers = slug === "trainerpool" ? await getTrainers() : [];
const legal = slug === "impressum" || slug === "datenschutz";
---

<Base
  title={
    slug === "trainingstermine"
      ? "Trainingstermine – deine nächste Eiszeit"
      : `${page.title} ${page.accent}`
  }
  description={page.description}
>
  <section class="page-hero">
    <div class="wrap">
      <a href="/" class="breadcrumb">
        STARTSEITE <span aria-hidden="true">/</span>{" "}
        {slug === "trainingsstaetten"
          ? "TRAININGSSTÄTTEN"
          : slug.toLocaleUpperCase("de-DE")}
      </a>
      <p class="eyebrow">{page.label}</p>
      <h1>
        {page.title}
        <br />
        <span>{page.accent}</span>
      </h1>
      <p class="page-intro">{page.intro}</p>
    </div>
    <div class="page-hero-lines" aria-hidden="true"></div>
  </section>
  {slug === "philosophie" && (
    <>
      <section class="section light-section">
        <div class="wrap">
          <div class="editorial-intro" data-reveal>
            <p class="eyebrow">DAS INDIVIDUUM IM TEAMSPORT</p>
            <h2>
              MEHR AUFMERKSAMKEIT.
              <br />
              <span>MEHR ENTWICKLUNG.</span>
            </h2>
            <p class="lead">
              Eishockey ist ein Teamsport. Und jedes Team besteht aus
              individuellen Stärken.
            </p>
            <p>
              Wir geben jungen Spielern bis U13 die Möglichkeit, ergänzend zum
              Vereinstraining an ihrer eigenen Entwicklung zu arbeiten. Mit
              persönlicher Betreuung und Inhalten, die zum jeweiligen
              Leistungsstand passen.
            </p>
          </div>
          <div class="principles">
            {principles.map((item) => (
              <article data-reveal>
                <span>{item.number}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </article>
            ))}
          </div>
          <Button href="/training">Unser Training kennenlernen</Button>
        </div>
      </section>
    </>
  )}
  {slug === "training" && (
    <>
      <TrainingStory />
      <section class="section light-section" id="zielgruppe">
        <div class="wrap target-layout">
          <div data-reveal>
            <p class="eyebrow">FÜR WEN WIR TRAINIEREN</p>
            <h2>
              DEIN LEVEL.
              <br />
              <span>DEIN NÄCHSTER SCHRITT.</span>
            </h2>
            <span class="target-age">
              KINDER & JUGENDLICHE <strong>BIS U13</strong>
            </span>
          </div>
          <div>
            <p class="lead">Individuelle Förderung in kleinen Gruppen.</p>
            <p>
              Das Angebot richtet sich an Kinder und Jugendliche bis U13. Die
              Inhalte werden an die Spieler und ihre Entwicklung angepasst.
              Vereins- und Mannschaftstraining bleiben die Basis.
            </p>
            <p>
              Die genaue Altersgruppe wird mit dem jeweiligen Trainingstermin
              veröffentlicht. Bei Fragen zur passenden Gruppe stehen künftig
              unsere Kontaktmöglichkeiten zur Verfügung.
            </p>
            <div class="target-actions">
              <Button href="/trainingstermine">Trainingstermine ansehen</Button>
            </div>
          </div>
        </div>
      </section>
      <section class="section">
        <div class="wrap">
          <p class="eyebrow">DEIN TRAININGSRAHMEN</p>
          <h2 class="mb-lg">
            KLAR. PERSÖNLICH.
            <br />
            <span>MIT PERSPEKTIVE.</span>
          </h2>
          <Pricing />
        </div>
      </section>
    </>
  )}
  {slug === "trainerpool" && (
    <section class="section">
      <div class="wrap">
        <div class="trainer-list">
          {trainers.map(trainer => <TrainerCard trainer={trainer} />)}
        </div>
        <div class="notice trainer-details">
          <p class="eyebrow">PERSÖNLICHE ENTWICKLUNG</p>
          <h3>Die Haltung hinter dem Training</h3>
          <p>{trainers.length ? "Kleine Gruppen und persönliche Aufmerksamkeit ergänzen das Mannschaftstraining." : "Aktuell sind keine Trainerprofile veröffentlicht."}</p>
          <Button href="/philosophie" variant="text">
            Unsere Haltung kennenlernen
          </Button>
        </div>
      </div>
    </section>
  )}
  {slug === "trainingsstaetten" && (
    <section class="section light-section">
      <div class="wrap">
        <p class="eyebrow">AKTUELLE TRAININGSSTÄDTE</p>
        <div class="city-details">
          {venues
            .filter((v) => v.status === "active_city")
            .map((venue, i) => (
              <article id={venue.id} data-reveal>
                <span class="city-number">0{i + 1}</span>
                <div>
                  <span class="status-label">TRAININGSSTADT</span>
                  <h2>{venue.city}</h2>
                  <p>{venue.details}</p>
                  {(venue.rinkName || venue.address) && <span class="small muted">
                    {venue.rinkName}{venue.rinkName && venue.address && <br />}{venue.address}
                  </span>}
                </div>
                <Button href="/trainingstermine" variant="text">
                  Termine ansehen
                </Button>
              </article>
            ))}
        </div>
        <div class="notice">
          <p class="eyebrow">IN PLANUNG</p>
          <h3>Die Region im Blick.</h3>
          <div class="planned-tags">
            {venues
              .filter((v) => v.status === "planned_city")
              .map((v) => (
                <span>
                  {v.city} <small>In Planung</small>
                </span>
              ))}
          </div>
          <p>
            Diese Standorte sind geplant. Es gibt dort noch keinen bestätigten
            Trainingsbetrieb.
          </p>
        </div>
      </div>
    </section>
  )}
  {slug === "trainingstermine" && (
    <>
      <section class="section light-section">
        <div class="wrap">
          <Schedule />
          <div class="schedule-info">
            <article>
              <span class="eyebrow">01 / DER RAHMEN</span>
              <h3>Eine Einheit. Zwei Phasen.</h3>
              <p>
                60 Minuten On-Ice plus 60 Minuten Off-Ice. Individuelle
                Entwicklung in kleinen Gruppen bis U13.
              </p>
              <a href="/training" class="inline-link">
                Mehr über das Training ↗
              </a>
            </article>
            <article>
              <span class="eyebrow">02 / DIE ORGANISATION</span>
              <h3>Wochenende. Wechselnde Orte.</h3>
              <p>
                Datum, Start- und Endzeit, Eishalle und Altersgruppe werden mit
                jedem einzelnen Termin veröffentlicht.
              </p>
              <a href="/organisation" class="inline-link">
                Organisation & Preise ↗
              </a>
            </article>
            <article>
              <span class="eyebrow">03 / DIE ANMELDUNG</span>
              <h3>Persönlich bestätigt.</h3>
              <p>
                Die Academy prüft jede Trainingsanfrage und bestätigt eine
                Buchung persönlich. Informationen zum Formular und die
                PDF-Vorlage findest du auf der Anmeldeseite.
              </p>
              <a href="/anmeldung" class="inline-link">
                Anmeldeformular & PDF ↗
              </a>
            </article>
          </div>
        </div>
      </section>
      <section class="qr-note">
        <div class="wrap">
          <span aria-hidden="true">↗</span>
          <div>
            <h2>DEIN FESTER WEG ZUM TRAINING.</h2>
            <p>
              Diese Seite bleibt die zentrale Anlaufstelle für Trainingstermine
              – auch über zukünftige QR-Codes.
            </p>
          </div>
        </div>
      </section>
    </>
  )}
  {slug === "organisation" && (
    <>
      <section class="section light-section">
        <div class="wrap">
          <p class="eyebrow">SO IST DAS TRAINING ORGANISIERT</p>
          <h2>
            VOM TERMIN
            <br />
            <span>ZUR ENTWICKLUNG.</span>
          </h2>
          <div class="principles">
            {organisationSteps.map((item) => (
              <article data-reveal>
                <span>{item.number}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </article>
            ))}
          </div>
          <Button href="/trainingstermine">Trainingstermine ansehen</Button>
        </div>
      </section>
      <section class="section">
        <div class="wrap">
          <p class="eyebrow">DIE PREISE</p>
          <h2 class="mb-lg">
            INVESTITION IN
            <br />
            <span>DEIN POTENZIAL.</span>
          </h2>
          <Pricing />
          <div class="notice">
            <p class="eyebrow">DEINE TRAININGSANFRAGE</p>
            <h3>Alle Angaben im Überblick.</h3>
            <p>Informationen zur Trainingsanfrage und die PDF-Vorlage findest du auf der Anmeldeseite. Ein Trainingsplatz wird erst durch die persönliche Bestätigung der Academy verbindlich zugesagt.</p>
            <Button href="/anmeldung" variant="text">Anmeldeformular & PDF ansehen</Button>
          </div>
        </div>
      </section>
    </>
  )}
  {slug === "kontakt" && (
    <section class="section light-section">
      <div class="wrap contact-layout">
        <div>
          <p class="eyebrow">DEIN DRAHT ZUR ACADEMY</p>
          <h2>HIER ERREICHST DU <span>UNS.</span></h2>
          <p class="lead">Schreib uns bei Fragen zum Training eine E-Mail.</p>
        </div>
        <div class="contact-options">
          <article>
            <h3>E-Mail</h3>
            <p><a class="contact-email" href="mailto:info@pkhockeyacademy.de">info@pkhockeyacademy.de</a></p>
          </article>
        </div>
      </div>
    </section>
  )}
  {legal && (
    <section class="section light-section">
      <div class="wrap legal-content">
        <div class="legal-warning">
          <strong>NICHT ZUR VERÖFFENTLICHUNG FREIGEGEBEN</strong>
          <p>
            {slug === "impressum"
              ? "Die Anbieterangaben wurden ergänzt und von Pierre bestätigt. Die abschließende rechtliche Prüfung und Freigabe für den Website-Start stehen aus."
              : "Diese Fassung beschreibt den vorgesehenen Produktionsbetrieb auf STRATO mit Sanity. Die Anbieter- und Vertragsangaben, die tatsächliche Umsetzung der Datenschutzregeln sowie die abschließende rechtliche Prüfung müssen vor dem öffentlichen Start abgeglichen werden. Die Darstellung schaltet keine Anmeldung frei."}
          </p>
        </div>
        {slug === "impressum" ? (
          <>
            <h2>ANBIETER</h2>
            <p>
              {legalProvider.brandName}<br />
              Inhaber: {legalProvider.owner}<br />
              {legalProvider.street}<br />
              {legalProvider.postalCode} {legalProvider.city}<br />
              {legalProvider.country}
            </p>
            <h2>KONTAKT</h2>
            <p>
              Telefon: <a href={legalProvider.phoneHref}>{legalProvider.phone}</a><br />
              E-Mail: <a href={`mailto:${legalProvider.email}`}>{legalProvider.email}</a><br />
              Website: <a href={legalProvider.website}>{legalProvider.website}</a>
            </p>
            <h2>UNTERNEHMENSFORM</h2>
            <p>
              {legalProvider.businessForm}<br />
              Inhaber: {legalProvider.owner}
            </p>
          </>
        ) : (
          <PrivacyPolicy />
        )}
        <Button href="/" variant="text">
          Zurück zur Startseite
        </Button>
      </div>
    </section>
  )}
  {!legal && slug !== "trainingstermine" && <FinalCTA />}
</Base>
