---
interface Props {
  label: string;
  title: string;
  light?: boolean;
  reveal?: boolean;
}
const { label, title, light = false, reveal = true } = Astro.props;
---

<div
  class:list={["section-heading", { "section-heading--light": light }]}
  data-reveal={reveal || undefined}
>
  <p class="eyebrow">
    <span></span>
    {label}
  </p>
  <h2>{title}</h2>
  <slot />
</div>
