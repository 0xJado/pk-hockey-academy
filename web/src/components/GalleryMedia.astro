---
import GalleryTile from "./GalleryTile.astro";
import VideoControls from "./VideoControls.astro";
import { Image } from "astro:assets";
import goalie from "../assets/gallery-goalie.png";
import { groupGalleryMedia } from "../lib/gallery";
import { layoutGalleryTiles } from "../lib/gallery-layout";
import type { GalleryAlbum } from "../types/gallery";
interface Props {
  album: GalleryAlbum;
}
const { album } = Astro.props;
const sections = groupGalleryMedia(album.media).map((section) => ({
  ...section,
  tiles: layoutGalleryTiles(section.media, 5),
  tablet: new Map(
    layoutGalleryTiles(section.media, 3).map((tile) => [tile.item.id, tile]),
  ),
}));
---

<camp-gallery>
  <div class="gallery-toolbar">
    <p>
      <strong>{album.media.length}</strong>{" "}
      {album.isLocalPreview ? "Medien in der Vorschau" : "Einblicke ins Camp"}
    </p>
  </div>
  <nav class="gallery-tabs" aria-label="Galerie-Bereiche" data-gallery-tabs>
    {sections.map((section, index) => (
      <a
        class="gallery-tab"
        id={`galerie-tab-${section.id}`}
        href={`#galerie-${section.id}`}
        data-gallery-tab={section.id}
        aria-current={index === 0 ? "true" : undefined}
      >
        <span data-gallery-tab-label>{section.title}</span>
      </a>
    ))}
    <span class="gallery-goalie" data-gallery-goalie aria-hidden="true" hidden>
      <Image src={goalie} width={176} alt="" loading="eager" />
    </span>
  </nav>
  {sections.map((section, sectionIndex) => (
    <section
      class="gallery-media-section"
      id={`galerie-${section.id}`}
      aria-labelledby={`galerie-heading-${section.id}`}
      data-gallery-section={section.id}
    >
      <div class="gallery-section-heading">
        <h2 id={`galerie-heading-${section.id}`}>{section.title}</h2>
      </div>
      <div class="camp-media-grid">
        {section.tiles.map((tile, index) => (
          <GalleryTile
            placement={tile}
            tablet={section.tablet.get(tile.item.id)!}
            eager={sectionIndex === 0 && index === 0}
          />
        ))}
      </div>
    </section>
  ))}
  <dialog
    class="gallery-dialog"
    aria-label="Medienansicht"
    aria-describedby="gallery-media-description"
    data-gallery-dialog
  >
    <div class="gallery-dialog-bar">
      <p data-media-position aria-live="polite"></p>
      <button
        type="button"
        data-gallery-close
        aria-label="Medienansicht schließen"
      >
        <span>Schließen</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <div class="gallery-dialog-stage">
      <img data-dialog-image alt="" hidden />
      <div
        class="gallery-player gallery-dialog-player"
        data-video-player
        data-dialog-player
        hidden
      >
        <video
          data-dialog-video
          controls
          playsinline
          preload="none"
          aria-describedby="gallery-media-description"
          hidden
        >
          Dein Browser kann dieses Video nicht abspielen.{" "}
          <a data-dialog-video-link>Video öffnen</a>.
        </video>
        <VideoControls />
      </div>
      <button
        type="button"
        class="gallery-viewer-nav gallery-viewer-prev"
        data-gallery-prev
        aria-label="Vorheriges Medium"
      >
        <svg viewBox="0 0 32 100" fill="none" aria-hidden="true">
          <path d="M24 6 8 50l16 44" />
        </svg>
      </button>
      <button
        type="button"
        class="gallery-viewer-nav gallery-viewer-next"
        data-gallery-next
        aria-label="Nächstes Medium"
      >
        <svg viewBox="0 0 32 100" fill="none" aria-hidden="true">
          <path d="m8 6 16 44L8 94" />
        </svg>
      </button>
    </div>
    <p
      id="gallery-media-description"
      class="gallery-sr-only"
      data-media-description
    ></p>
  </dialog>
</camp-gallery>
<script>
  import { installGallery } from "../lib/gallery-interactions";
  installGallery();
</script>
