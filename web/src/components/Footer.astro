---
import Wordmark from "./Wordmark.astro";
---

<footer class="site-footer">
  <div class="wrap footer-main">
    <div>
      <Wordmark footer />
      <p>
        Skills. Mindset. Zukunft.
        <br />
        Individuelle Entwicklung bis U13.
      </p>
    </div>
    <div>
      <span class="eyebrow muted">DIE ACADEMY</span>
      <a href="/philosophie">Philosophie</a>
      <a href="/trainerpool">Trainerpool</a>
      <a href="/trainingsstaetten">Trainingsstätten</a>
    </div>
    <div>
      <span class="eyebrow muted">DEIN TRAINING</span>
      <a href="/training">Trainingskonzept</a>
      <a href="/trainingstermine">Trainingstermine</a>
      <a href="/organisation">Organisation & Preise</a>
      <a href="/kontakt">Kontakt</a>
    </div>
    <div class="footer-note">
      <span class="status-dot"></span> WEBSITE IN VORBEREITUNG
      <p>
        Termine und Kontaktmöglichkeiten folgen. Aktuell ist keine Anmeldung
        möglich.
      </p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© {new Date().getFullYear()} PK Hockey Academy</span>
    <span>
      <a href="/impressum">Impressum</a>
