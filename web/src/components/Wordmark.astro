---
import { Image } from "astro:assets";
import crest from "../assets/brand/pk-hockey-crest.png";
interface Props {
  footer?: boolean;
}
const { footer = false } = Astro.props;
---

<a
  class:list={["wordmark", { "wordmark--footer": footer }]}
  href="/"
  aria-label="PK Hockey Academy – Startseite"
>
  <Image
    src={crest}
    width={footer ? 112 : 88}
    height={footer ? 112 : 88}
    densities={[1, 2]}
    format="webp"
    quality={90}
    alt=""
    loading={footer ? "lazy" : "eager"}
    class="wordmark-crest"
  />
  <span class="wordmark-copy">
    <span class="wordmark-name">PK HOCKEY ACADEMY</span>
    <span class="wordmark-tagline">INDIVIDUELLES EISHOCKEYTRAINING</span>
  </span>
</a>
