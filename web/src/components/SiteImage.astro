---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import type { SiteImageKey } from "../../../shared/site-images.ts";
import { getSiteImages } from "../lib/site-images-source";
import { imageUrl } from "../lib/gallery";

type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height" | "alt"> & {
  imageKey: SiteImageKey;
  fallback: string | ImageMetadata;
  width: number;
  height?: number;
  alt: string;
};
const { imageKey, fallback, width, height, alt, ...attributes } = Astro.props;
const photo = (await getSiteImages())[imageKey];
const widths = photo
  ? [...new Set([width, width * 2].map((size) => Math.min(size, photo.width)))]
  : [];
---

{photo ? (
  <img
    {...attributes}
    src={imageUrl(photo, width)}
    srcset={widths.map((size) => `${imageUrl(photo, size)} ${size}w`).join(", ")}
    sizes={attributes.sizes ?? `${width}px`}
    width={width}
    height={height ?? Math.round(width * photo.height / photo.width)}
    alt={alt === "" ? "" : photo.alt}
    decoding="async"
  />
) : typeof fallback === "string" ? (
  <img {...attributes} src={fallback} width={width} height={height} alt={alt} />
) : (
  <Image
    {...attributes}
    src={fallback}
    width={width}
    height={height}
    densities={[1, 2]}
    format="webp"
    quality={90}
    alt={alt}
  />
)}
