---
import Policy, { getHeadings } from "../content/legal/datenschutz.md";
const sections = getHeadings().filter(({ depth }) => depth === 2);
---

<p class="policy-date">Stand: November 2026</p>
<nav class="policy-contents" aria-label="Inhalt der Datenschutzerklärung">
  <p class="eyebrow">INHALT</p>
  <ol>
    {sections.map(({ slug, text }) => (
      <li><a href={`#${slug}`}>{text.replace(/^\d+\.\s*/, "")}</a></li>
    ))}
  </ol>
</nav>
<div class="privacy-copy"><Policy /></div>

<style>
  .policy-date { margin-bottom: 24px; font-size: 14px; }
  .policy-contents { padding: 28px; border: 1px solid #b6c9d8; margin-bottom: 56px; }
  .policy-contents ol { columns: 2; column-gap: 40px; padding-left: 24px; margin-top: 18px; }
  .policy-contents li { break-inside: avoid; padding: 7px 0; font-size: 14px; line-height: 1.6; }
  .policy-contents a, .privacy-copy :global(a) {
    text-decoration: underline;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .privacy-copy { font-size: 16px; line-height: 1.85; overflow-wrap: anywhere; }
  .privacy-copy :global(h2) {
    margin: 52px 0 20px;
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.2;
    scroll-margin-top: 150px;
  }
  .privacy-copy :global(h3) { font-size: 25px; margin: 28px 0 16px; scroll-margin-top: 150px; }
  .privacy-copy :global(p) { margin-bottom: 20px; }
  .privacy-copy :global(ul) { list-style: disc; padding-left: 24px; margin: 20px 0 28px; }
  .privacy-copy :global(li) { padding: 6px 0; }
  @media (max-width: 600px) {
    .policy-contents { padding: 22px; }
    .policy-contents ol { columns: 1; }
  }
</style>
