---
import Wordmark from "./Wordmark.astro";
import Arrow from "./Arrow.astro";
import { navigation } from "../data/academy";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="header-band">
    <div class="wrap">
      <span>GEMEINSAM BESSER WERDEN. AUF UND NEBEN DEM EIS.</span>
      <span>ESSEN · DINSLAKEN · DUISBURG</span>
    </div>
  </div>
  <div class="header-inner wrap">
    <Wordmark />
    <nav class="desktop-nav" aria-label="Hauptnavigation">
      {navigation.map(({ href, label }) => (
        <a href={href} aria-current={path === href ? "page" : undefined}>
          {label}
        </a>
      ))}
      <a
        href="/galerie"
        aria-current={path.startsWith("/galerie") ? "page" : undefined}
      >
        Galerie
      </a>
    </nav>
    <a
      class="header-cta"
      href="/trainingstermine"
      aria-current={path === "/trainingstermine" ? "page" : undefined}
    >
      Trainingstermine <Arrow diagonal />
    </a>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="Navigation öffnen oder schließen">
        <span>Menü</span>
        <span class="menu-bars" aria-hidden="true"></span>
      </summary>
      <nav aria-label="Mobile Navigation">
        {navigation.map(({ href, label }) => (
          <a href={href} aria-current={path === href ? "page" : undefined}>
            {label}
            <Arrow />
          </a>
        ))}
        <a
          href="/galerie"
          aria-current={path.startsWith("/galerie") ? "page" : undefined}
        >
          Galerie <Arrow />
        </a>
        <a href="/trainingstermine">
          Trainingstermine
          <Arrow />
        </a>
        <a href="/organisation">
          Organisation
          <Arrow />
        </a>
        <a href="/kontakt">
          Kontakt
          <Arrow />
        </a>
      </nav>
    </details>
  </div>
</header>
