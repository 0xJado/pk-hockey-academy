---
import Button from "./Button.astro";
import { Image } from "astro:assets";
import crest from "../assets/brand/pk-hockey-crest.png";
import { getAcademy } from "../lib/content";
const trainer = getAcademy().trainers[0]!;
---

<article class="trainer-feature" data-reveal>
  <a
    href="/trainerpool"
    class="trainer-portrait"
    aria-label="Pierre Klein – Trainerprofil ansehen"
  >
    <Image
      src={crest}
      width={500}
      densities={[1, 2]}
      format="webp"
      quality={90}
      alt="Wappen der PK Hockey Academy. Ein separates Trainerfoto folgt."
      loading="lazy"
    />
    <span class="image-label">PIERRE KLEIN · GRÜNDER & TRAINER</span>
    <span class="portrait-overlay">
      Trainerprofil ansehen <span aria-hidden="true">↗</span>
    </span>
  </a>
  <div class="trainer-copy">
    <p class="eyebrow">PERSÖNLICH. AUFMERKSAM. ENGAGIERT.</p>
    <h2>
      DEIN TRAINER.
      <br />
      <span>PIERRE KLEIN.</span>
    </h2>
    <p class="trainer-role">{trainer.role} · PK Hockey Academy</p>
    <p>
      Hinter jedem Entwicklungsschritt steht ein Mensch, der genau hinschaut.
      Pierre Klein hat die Academy für die individuelle Förderung junger
      Eishockeyspieler gegründet.
    </p>
    <p>
      Sein Hintergrund verbindet Eishockey und Inlinehockey. Das Training der
      Academy konzentriert sich auf Eishockey.
    </p>
    <Button href="/trainerpool" variant="text">
      Pierre kennenlernen
    </Button>
    <p class="small muted">
      Separates Trainerfoto, ausführliche Biografie und bestätigte
      Qualifikationen folgen.
    </p>
  </div>
</article>
