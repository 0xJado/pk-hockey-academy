---
import GalleryImage from "./GalleryImage.astro";
import VideoControls from "./VideoControls.astro";
import { imageUrl } from "../lib/gallery";
import type { GalleryTilePlacement } from "../lib/gallery-layout";
import type { GalleryMedia } from "../types/gallery";
interface Props {
  placement: GalleryTilePlacement<GalleryMedia>;
  tablet: GalleryTilePlacement<GalleryMedia>;
  eager?: boolean;
}
const { placement, tablet, eager = false } = Astro.props;
const { item } = placement;
const spotlight = item.type === "image" ? item.spotlight : undefined;
const sizes = spotlight
  ? "(max-width: 700px) calc(100vw - 40px), (max-width: 1000px) 66vw, (min-width: 1392px) 505px, 40vw"
  : "(max-width: 700px) calc(100vw - 40px), (max-width: 1000px) 33vw, (min-width: 1392px) 247px, 20vw";
---

<figure
  class="camp-media"
  data-media-type={item.type}
  data-media-id={item.id}
  data-gallery-order={placement.order}
  data-spotlight={spotlight}
  style={`--tile-column:${placement.column};--tile-row:${placement.row};--tile-span:${placement.span};--tablet-column:${tablet.column};--tablet-row:${tablet.row}`}
>
  {item.type === "image" ? (
    <a
      href={imageUrl(item, 2000)}
      data-gallery-photo
      data-gallery-open
      class="camp-photo"
      aria-label={`Foto vergrößern: ${item.alt}`}
    >
      <GalleryImage image={item} eager={eager} sizes={sizes} />
    </a>
  ) : (
    <div class="gallery-player" data-video-player>
      <video
        controls
        playsinline
        preload="none"
        poster={imageUrl(item.poster, 640)}
        width={item.poster.width}
        height={item.poster.height}
        aria-label={item.title}
        aria-describedby={`transcript-${item.id}`}
      >
        <source src={item.url} type={item.mimeType} />
        Dein Browser kann dieses Video nicht abspielen.{" "}
        <a href={item.url}>Video öffnen</a>.
      </video>
      <VideoControls />
    </div>
  )}
  <figcaption class="gallery-sr-only">
    {item.type === "video" && <span>{item.title}</span>}
    {item.caption && <span>{item.caption}</span>}
    <small>Aufnahme: {item.credit}</small>
    {item.type === "video" && item.poster.credit !== item.credit && (
      <small>Vorschaubild: {item.poster.credit}</small>
    )}
    {item.type === "video" && (
      <span id={`transcript-${item.id}`}>{item.transcript}</span>
    )}
  </figcaption>
</figure>
