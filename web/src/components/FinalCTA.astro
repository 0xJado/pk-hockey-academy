---
import Button from "./Button.astro";
import PKOutline from "./PKOutline.astro";
import { getAcademy } from "../lib/content";
const email = getAcademy().settings.contactDestinations?.email;
const onContact = Astro.url.pathname.replace(/\/$/, "") === "/kontakt";
---

<section class="final-cta">
  <div class="wrap final-cta-inner">
    <div data-reveal>
      <p class="eyebrow">DER NÄCHSTE SCHRITT GEHÖRT DIR.</p>
      <h2>
        BEREIT FÜR
        <br />
        MEHR <span>POTENZIAL?</span>
      </h2>
    </div>
    <div class="final-cta-actions">
      <Button href="/trainingstermine">Trainingstermine ansehen</Button>
      <Button href={onContact && email ? `mailto:${email}` : "/kontakt"} variant="outline">
        {onContact && email ? "E-Mail schreiben" : "Training anfragen"}
      </Button>
      <p>Individuelles Training. Gemeinsame Entwicklung.</p>
    </div>
  </div>
  <PKOutline class="cta-pk" />
</section>

<style>
  .final-cta > :global(.cta-pk) {
    position: absolute;
    width: min(700px, 76%);
    height: 155%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: #80ccff;
    opacity: 0.22;
    pointer-events: none;
    z-index: -1;
  }
  @media (max-width: 600px) {
    .final-cta > :global(.cta-pk) {
      width: 120%;
      max-width: none;
      height: 100%;
      left: 65%;
      opacity: 0.16;
    }
  }
</style>
