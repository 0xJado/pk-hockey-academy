---
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import crest from "../assets/brand/pk-hockey-crest.png";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const launchReady =
  import.meta.env.PUBLIC_LAUNCH_READY === "true" && !!canonical;
const favicon = await getImage({ src: crest, width: 64, format: "png" });
const socialCrest = await getImage({ src: crest, width: 512, format: "png" });
const socialImage = Astro.site
  ? new URL(socialCrest.src, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050B12" />
    <title>{title} | PK Hockey Academy</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={launchReady ? "index,follow" : "noindex,nofollow"}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="PK Hockey Academy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="512" />
        <meta property="og:image:height" content="512" />
        <meta
          property="og:image:alt"
          content="PK Hockey Academy – Skills. Mindset. Zukunft."
        />
        <meta name="twitter:image" content={socialImage} />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <ClientRouter fallback="none" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">
      Zum Inhalt springen
    </a>
    <Header />
    <main id="inhalt" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <script>
      import { installMotion } from "../lib/motion";
      installMotion();
    </script>
  </body>
</html>
