# Optional. Leave blank for local previews. Never use a fictional production URL.
SITE_URL=
# Keep false until content, contacts and legal pages are approved.
PUBLIC_LAUNCH_READY=false

# Optional gallery CMS. Leave ALL THREE blank for an honest empty gallery.
# Use the same project/dataset as studio/.env. Keep the dataset private.
# Token: Viewer/read-only, build server only. NEVER prefix it with PUBLIC_.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_READ_TOKEN=
# Set only after the authenticated Studio is deployed, e.g. its actual HTTPS URL.
PUBLIC_SANITY_STUDIO_URL=
