# Optional. Leave blank for local previews. Never use a fictional production URL.
SITE_URL=
# Keep false until content, contacts and legal pages are approved.
PUBLIC_LAUNCH_READY=false

# Optional gallery CMS. Leave project, dataset and token blank to disable.
# Use the same project/dataset as studio/.env. Sanity Free: PUBLIC dataset.
# Only public website content belongs here; registrations go to a private Google Sheet.
SANITY_PROJECT_ID=
SANITY_DATASET=
# Leave blank for the public dataset. Optional private-dataset support only:
# Viewer/read-only token, build server only. NEVER prefix it with PUBLIC_.
SANITY_READ_TOKEN=
# Optional coach migration. Keep false until approved profiles are ready in Sanity.
# When true, CMS is authoritative: empty/unpublished profiles stay absent.
SANITY_TRAINERS_ENABLED=false
# Set only after the authenticated Studio is deployed, e.g. its actual HTTPS URL.
PUBLIC_SANITY_STUDIO_URL=
