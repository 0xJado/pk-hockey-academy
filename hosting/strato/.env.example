# Local deployment/acceptance credentials. Copy to .env.local; never commit that copy.
# Obtain the exact SFTP host/username from STRATO's SFTP & SSH overview.
STRATO_SFTP_HOST=
STRATO_SFTP_PORT=22
STRATO_SFTP_USERNAME=
STRATO_SFTP_PASSWORD=""

# Separate temporary website-review login; do not reuse the SFTP/account password.
# Review password must be 12–72 UTF-8 bytes for the bcrypt acceptance setup.
STRATO_PREVIEW_USERNAME=academy-review
STRATO_PREVIEW_PASSWORD=""

# CI uses the existing pinned raw host key in Actions secrets instead of a local record.
# Leave blank locally to use output/strato-private/host-key.json.
STRATO_SFTP_HOST_KEY=""

# Later Sanity webhook setup only: fine-grained GitHub PAT, this repo, Actions: write.
# Never put this token on STRATO or send it in chat. Expiry/renewal must be tracked privately.
STRATO_DISPATCH_TOKEN=""
