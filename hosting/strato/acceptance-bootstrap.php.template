<?php
declare(strict_types=1);
// One-use deployment acceptance helper. Token hash is substituted locally.
// Never deploy this template as a permanent endpoint. No personal data is handled.
ini_set('display_errors', '0');
header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');
header('X-Robots-Tag: noindex, nofollow');
header('X-Content-Type-Options: nosniff');
function reply(int $status, array $data): never {
    http_response_code($status);
    echo json_encode($data, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);
    exit;
}
if ($_SERVER['REQUEST_METHOD'] !== 'POST') reply(403, ['code' => 'setup_auth_required']);
$token = $_SERVER['HTTP_X_PK_SETUP_TOKEN'] ?? '';
if (!is_string($token) || !hash_equals('__TOKEN_SHA256__', hash('sha256', $token))) {
    reply(403, ['code' => 'setup_auth_required']);
}
if ((int) ($_SERVER['CONTENT_LENGTH'] ?? 0) > 4096) reply(413, ['code' => 'too_large']);
try {
    $body = json_decode(file_get_contents('php://input', false, null, 0, 4097), true, 8, JSON_THROW_ON_ERROR);
    if (!is_array($body)) reply(400, ['code' => 'invalid_request']);
    $public = realpath(__DIR__);
    $private = realpath(dirname(__DIR__) . '/private');
    if (!$public || !$private || str_starts_with($private . '/', $public . '/') || !is_writable($private)) {
        reply(503, ['code' => 'private_directory_unavailable']);
    }
    $report = [
        'phpVersion' => PHP_VERSION,
        'extensions' => array_combine(
            ['pdo', 'pdo_mysql', 'json', 'openssl', 'session', 'mbstring', 'fileinfo', 'sodium'],
            array_map('extension_loaded', ['pdo', 'pdo_mysql', 'json', 'openssl', 'session', 'mbstring', 'fileinfo', 'sodium'])
        ),
        'pdoDrivers' => class_exists('PDO') ? PDO::getAvailableDrivers() : [],
        'publicPath' => $public,
        'privatePath' => $private,
        'privateOutsidePublic' => true,
        'privateWritable' => true,
    ];
    if (($body['action'] ?? '') === 'inspect') {
        $check = tempnam($private, 'pk-acceptance-');
        if (!$check) reply(503, ['code' => 'private_write_failed']);
        $written = file_put_contents($check, 'PK private configuration acceptance', LOCK_EX);
        $readBack = $written !== false && file_get_contents($check) === 'PK private configuration acceptance';
        $removed = unlink($check);
        if (!$readBack || !$removed) reply(503, ['code' => 'private_read_write_failed']);
        reply(200, $report + ['privateReadWriteVerified' => true, 'privateProbeRemoved' => true]);
    }
    if (($body['action'] ?? '') !== 'install') reply(400, ['code' => 'invalid_action']);
    $username = $body['username'] ?? null;
    $password = $body['password'] ?? null;
    if (!is_string($username) || !preg_match('/\A[a-zA-Z0-9_-]{3,40}\z/', $username)
        || !is_string($password) || strlen($password) < 12 || strlen($password) > 72
        || str_contains($password, "\0")) reply(400, ['code' => 'invalid_review_credentials']);
    $passwordFile = $private . '/website-review.htpasswd';
    if (file_exists($passwordFile)) reply(409, ['code' => 'review_credentials_already_exist']);
    $hash = password_hash($password, PASSWORD_BCRYPT, ['cost' => 12]);
    $credentialHandle = fopen($passwordFile, 'x');
    if (!$credentialHandle) reply(503, ['code' => 'private_write_failed']);
    if (fwrite($credentialHandle, $username . ':' . $hash . "\n") === false) throw new RuntimeException('write');
    fclose($credentialHandle);
    chmod($passwordFile, 0644); // Apache must read it; outside web root and denied by parent guard.
    file_put_contents($private . '/.htaccess', "Require all denied\n", LOCK_EX);
    $credentialPath = str_replace(['\\', '"'], ['\\\\', '\\"'], $passwordFile);
    if (preg_match('/[\r\n]/', $credentialPath)) throw new RuntimeException('path');
    $guard = "Options -Indexes -MultiViews\n"
        . "DirectoryIndex index.html\nAuthMerging Off\nAuthType Basic\n"
        . "AuthName \"PK Hockey Academy - Interne Vorschau\"\n"
        . "AuthBasicProvider file\nAuthUserFile \"" . $credentialPath . "\"\nRequire valid-user\n"
        . "<FilesMatch \"^\\.\">\n  Require all denied\n</FilesMatch>\n"
        . "<IfModule mod_headers.c>\n  Header always set X-Robots-Tag \"noindex, nofollow\"\n"
        . "  Header always set Cache-Control \"no-store\"\n</IfModule>\n";
    // Only this exact random bootstrap file can bypass Apache auth while finishing setup;
    // it still requires the single-use token. The exception is removed before cleanup.
    $exception = "<Files \"" . basename(__FILE__) . "\">\n  Require all granted\n</Files>\n";
    file_put_contents($private . '/website-review-apache.conf', $guard, LOCK_EX);
    file_put_contents($public . '/.htaccess.setup-next', $guard . $exception, LOCK_EX);
    if (!rename($public . '/.htaccess.setup-next', $public . '/.htaccess')) throw new RuntimeException('activate');
    reply(200, $report + ['reviewGateInstalled' => true]);
} catch (Throwable $error) {
    reply(503, ['code' => 'acceptance_setup_failed']);
}
