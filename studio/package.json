{
  "name": "pk-hockey-academy-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "sanity dev --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "sanity build",
    "schema:extract": "sanity schema extract",
    "media-kit:migrate-logo": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate-media-kit-logo.mjs",
    "deploy": "sanity deploy",
    "webhook:setup": "node --env-file-if-exists=.env --experimental-strip-types scripts/configure-publication-hook.mjs"
  },
  "dependencies": {
    "@sanity/locale-de-de": "1.1.37",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.20.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "typescript": "6.0.3"
  }
}
