# Public identifiers, available in sanity.io/manage. Never put tokens here.
# Sanity Free: use a public dataset for website content only, never registrations.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
# Optional native login choice: google, github or sanity. Blank keeps native defaults.
# Configure only after membership and recovery are verified for that sign-in method.
# This does not enable or enforce MFA; configure that at the identity provider.
SANITY_STUDIO_AUTH_PROVIDER=
